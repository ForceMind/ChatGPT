{
  "manifest_version": 2,
  "name": "Studio environment bridge",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "studio-environment@local.invalid",
      "strict_min_version": "91.1.0"
    },
    "gecko_android": {}
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "proxy",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "route.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "recovery.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
