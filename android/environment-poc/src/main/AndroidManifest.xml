        <activity android:name=".AccountBActivity" android:process=":account_b" android:exported="false" android:launchMode="singleTask" />
        <activity android:name=".GroupedAActivity" android:exported="true" android:launchMode="singleTask" />
        <activity android:name=".GroupedBActivity" android:process=":group_b" android:exported="false" android:launchMode="singleTask" />
